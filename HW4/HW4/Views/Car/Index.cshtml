@model List<HW4.Models.Car>

@{
    ViewData["Title"] = "Available Cars";
}
<div>
    <h2>Available Cars</h2>
    <p>Here are the cars currently available for rent:</p>

</div>

    
    @if (Model.Count == 0){
        <div>
                No cars are currently available.

        </div>     
    }
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var car in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column p-4">

                        <h5 class="card-title fw-bold">
                            @car.id
                        </h5>

                        <h6 class="card-subtitle mb-2 text-muted">
                            @car.name
                        </h6>

                        <p class="card-text fs-5 mb-3">
                            PKR @car.pricePerDay.ToString("N0")
                            <span class="text-muted fs-6">/ day</span>
                        </p>

                        <div class="mb-4">
                            <span class="badge bg-success">
                                Available
                            </span>
                        </div>

                        <form asp-controller="Car"
                              asp-action="Book"
                              method="post"
                              class="mt-auto">

                            <input type="hidden"
                                   name="id"
                                   value="@car.id" />

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Book Car
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
}


